generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  CUSTOM
}

enum ItemUnit {
  KG
  G
  L
  ML
  PIECE
  PACK
}

enum ConsumptionUnit {
  TEASPOON
  TABLESPOON
  CUP
  PIECE
  ML
  MINUTE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions        Session[]
  pantryItems     PantryItem[]
  purchases       Purchase[]
  budgets         Budget[]
  mealPlans       MealPlan[]
  mealCompletions MealCompletion[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  deviceInfo String?   @map("device_info")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model PantryItem {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  name             String
  icon             String
  unit             ItemUnit
  consumptionUnit  ConsumptionUnit @map("consumption_unit")
  conversionRate   Decimal         @map("conversion_rate") @db.Decimal(12, 6)
  capacityQuantity Decimal         @map("capacity_quantity") @db.Decimal(12, 3)
  currentQuantity  Decimal         @map("current_quantity") @db.Decimal(12, 3)
  lowStockQuantity Decimal?        @map("low_stock_quantity") @db.Decimal(12, 3)
  thresholdDays    Int?
  frequency        Int?
  people           Int?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases  Purchase[]
  budgetItems BudgetItem[]
  mealItems  MealItem[]
  consumptionItems ConsumptionItem[]

  @@index([userId, name])
  @@map("pantry_items")
}

model Purchase {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  date      DateTime @db.Date
  quantity  Decimal  @db.Decimal(12, 3)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item PantryItem @relation(fields: [itemId], references: [id])

  @@index([userId, date])
  @@index([itemId, date])
  @@map("purchases")
}

model Budget {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  name      String
  limit     Decimal      @db.Decimal(12, 2)
  period    BudgetPeriod
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BudgetItem[]

  @@map("budgets")
}

model BudgetItem {
  id       String @id @default(uuid()) @db.Uuid
  budgetId String @map("budget_id") @db.Uuid
  itemId   String @map("item_id") @db.Uuid

  budget Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  item   PantryItem @relation(fields: [itemId], references: [id])

  @@unique([budgetId, itemId])
  @@map("budget_items")
}

model MealPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@unique([userId, date])
  @@map("meal_plans")
}

model Meal {
  id         String   @id @default(uuid()) @db.Uuid
  mealPlanId String   @map("meal_plan_id") @db.Uuid
  type       MealType
  label      String
  scheduledAt String? @map("scheduled_at")
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  mealPlan    MealPlan          @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items       MealItem[]
  completion  MealCompletion?

  @@map("meals")
}

model MealItem {
  id       String  @id @default(uuid()) @db.Uuid
  mealId   String  @map("meal_id") @db.Uuid
  itemId   String  @map("item_id") @db.Uuid
  quantity Decimal @db.Decimal(12, 3)

  meal Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  item PantryItem  @relation(fields: [itemId], references: [id])

  @@unique([mealId, itemId])
  @@map("meal_items")
}

model MealCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  mealId      String   @map("meal_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at")
  undoneAt    DateTime? @map("undone_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal    Meal              @relation(fields: [mealId], references: [id])
  items   ConsumptionItem[]

  @@unique([mealId])
  @@map("meal_completions")
}

model ConsumptionItem {
  id           String  @id @default(uuid()) @db.Uuid
  completionId String  @map("completion_id") @db.Uuid
  itemId       String  @map("item_id") @db.Uuid
  quantity     Decimal @db.Decimal(12, 3)

  completion MealCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  item       PantryItem     @relation(fields: [itemId], references: [id])

  @@map("consumption_items")
}
